{
  "name": "@snip-pick/api",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-tenant Snip Pick API: vault storage guarded by better-auth as an OAuth 2.1 authorization server.",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "tsx --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:migrate": "tsx --env-file-if-exists=.env src/migrate.ts"
  },
  "dependencies": {
    "@hono/node-server": "catalog:",
    "@snip-pick/auth": "workspace:*",
    "@snip-pick/auth-verify": "workspace:*",
    "@snip-pick/config": "workspace:*",
    "@snip-pick/contracts": "workspace:*",
    "@snip-pick/db": "workspace:*",
    "drizzle-orm": "catalog:",
    "hono": "catalog:"
  },
  "devDependencies": {
    "tsx": "catalog:"
  }
}
