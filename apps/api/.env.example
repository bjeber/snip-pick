# Postgres connection string. `npm run db:up` from the repo root starts a matching container.
DATABASE_URL=postgres://snippick:snippick@localhost:55432/snippick

# Signing secret for sessions and tokens. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-in-production

# Public origin of this API. Must match what clients are pointed at, because it is the OAuth
# issuer and every redirect is validated against it. Must be an absolute http(s) URL; anything
# else is ignored (plain BASE_URL is also read, but other tooling likes to claim that name).
SNIPPICK_BASE_URL=http://localhost:8787
PORT=8787

# Redirect URIs allowed for the bundled VS Code client. The first is the extension's URI handler;
# the second is what VS Code hands back under Remote SSH, Codespaces and vscode.dev, where
# asExternalUri tunnels through a web redirect.
VSCODE_REDIRECT_URIS=vscode://bieber.snip-pick/auth,vscode-insiders://bieber.snip-pick/auth,https://vscode.dev/redirect

# Let unknown clients register themselves (RFC 7591). Off by default: the VS Code client is
# seeded at boot, so nothing needs this unless you are building a third-party client.
ALLOW_DYNAMIC_CLIENT_REGISTRATION=false
