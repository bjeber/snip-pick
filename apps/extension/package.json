{
  "name": "snip-pick",
  "displayName": "Snip Pick \u2013 Snippets & Shell Commands",
  "description": "Collect code snippets and shell commands, group them, and insert or run them from a fast, file-context aware Quick Pick.",
  "version": "0.1.0",
  "publisher": "bieber",
  "license": "MIT",
  "author": "Bieber",
  "repository": {
    "type": "git",
    "url": "https://github.com/bjeber/snip-pick.git"
  },
  "bugs": {
    "url": "https://github.com/bjeber/snip-pick/issues"
  },
  "homepage": "https://github.com/bjeber/snip-pick#readme",
  "icon": "media/icon.png",
  "categories": [
    "Snippets",
    "Other"
  ],
  "keywords": [
    "snippets",
    "shell",
    "commands",
    "terminal",
    "cheatsheet"
  ],
  "engines": {
    "vscode": "^1.95.0",
    "node": ">=20"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Workspace snippets/commands are read-only and commands cannot be run in untrusted workspaces."
    },
    "virtualWorkspaces": {
      "supported": "limited",
      "description": "Terminals are not available in virtual workspaces, so commands can only be copied."
    }
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "snipPick",
          "title": "Snip Pick",
          "icon": "$(symbol-snippet)"
        }
      ]
    },
    "views": {
      "snipPick": [
        {
          "id": "snipPick.library",
          "name": "Library"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "snipPick.library",
        "contents": "No snippets yet.\n[Add Snippet](command:snipPick.addSnippet)\n[Add Command](command:snipPick.addCommand)"
      }
    ],
    "jsonValidation": [
      {
        "fileMatch": ".vscode/snippick.json",
        "url": "./schemas/snippick.schema.json"
      }
    ],
    "commands": [
      {
        "command": "snipPick.open",
        "title": "Open\u2026",
        "category": "Snip Pick",
        "icon": "$(search)"
      },
      {
        "command": "snipPick.addSnippet",
        "title": "Add Snippet",
        "category": "Snip Pick",
        "icon": "$(add)"
      },
      {
        "command": "snipPick.addSnippetFromSelection",
        "title": "Add Snippet from Selection",
        "category": "Snip Pick",
        "icon": "$(add)"
      },
      {
        "command": "snipPick.addCommand",
        "title": "Add Command",
        "category": "Snip Pick",
        "icon": "$(terminal)"
      },
      {
        "command": "snipPick.newGroup",
        "title": "New Group",
        "category": "Snip Pick",
        "icon": "$(new-folder)"
      },
      {
        "command": "snipPick.insert",
        "title": "Insert Snippet",
        "category": "Snip Pick",
        "icon": "$(insert)"
      },
      {
        "command": "snipPick.run",
        "title": "Run Command",
        "category": "Snip Pick",
        "icon": "$(play)"
      },
      {
        "command": "snipPick.copy",
        "title": "Copy to Clipboard",
        "category": "Snip Pick",
        "icon": "$(copy)"
      },
      {
        "command": "snipPick.edit",
        "title": "Edit\u2026",
        "category": "Snip Pick",
        "icon": "$(edit)"
      },
      {
        "command": "snipPick.editAsJson",
        "title": "Edit as JSON",
        "category": "Snip Pick"
      },
      {
        "command": "snipPick.delete",
        "title": "Delete",
        "category": "Snip Pick",
        "icon": "$(trash)"
      },
      {
        "command": "snipPick.togglePin",
        "title": "Pin / Unpin",
        "category": "Snip Pick",
        "icon": "$(pinned)"
      },
      {
        "command": "snipPick.duplicate",
        "title": "Duplicate",
        "category": "Snip Pick"
      },
      {
        "command": "snipPick.moveToGroup",
        "title": "Move to Group\u2026",
        "category": "Snip Pick"
      },
      {
        "command": "snipPick.renameGroup",
        "title": "Rename Group",
        "category": "Snip Pick",
        "icon": "$(edit)"
      },
      {
        "command": "snipPick.deleteGroup",
        "title": "Delete Group",
        "category": "Snip Pick",
        "icon": "$(trash)"
      },
      {
        "command": "snipPick.toggleRelevantOnly",
        "title": "Toggle \"Relevant Only\"",
        "category": "Snip Pick",
        "icon": "$(filter)"
      },
      {
        "command": "snipPick.showAllItems",
        "title": "Show All Items",
        "category": "Snip Pick",
        "icon": "$(filter-filled)"
      },
      {
        "command": "snipPick.refresh",
        "title": "Refresh",
        "category": "Snip Pick",
        "icon": "$(refresh)"
      },
      {
        "command": "snipPick.export",
        "title": "Export\u2026",
        "category": "Snip Pick"
      },
      {
        "command": "snipPick.import",
        "title": "Import\u2026",
        "category": "Snip Pick"
      },
      {
        "command": "snipPick.importCodeSnippets",
        "title": "Import .code-snippets\u2026",
        "category": "Snip Pick"
      },
      {
        "command": "snipPick.exportCodeSnippets",
        "title": "Export Group as .code-snippets\u2026",
        "category": "Snip Pick"
      },
      {
        "command": "snipPick.setSecret",
        "title": "Set Secret\u2026",
        "category": "Snip Pick"
      },
      {
        "command": "snipPick.clearSecrets",
        "title": "Clear Secrets\u2026",
        "category": "Snip Pick"
      },
      {
        "command": "snipPick.copyDiscovered",
        "title": "Copy to My Commands",
        "category": "Snip Pick",
        "icon": "$(add)"
      },
      {
        "command": "snipPick.activate",
        "title": "Insert or Run",
        "category": "Snip Pick"
      },
      {
        "command": "snipPick.signIn",
        "title": "Sign In to a Server\u2026",
        "category": "Snip Pick",
        "icon": "$(sign-in)"
      },
      {
        "command": "snipPick.signOut",
        "title": "Sign Out",
        "category": "Snip Pick",
        "icon": "$(sign-out)"
      },
      {
        "command": "snipPick.resolveConflicts",
        "title": "Resolve Vault Conflicts\u2026",
        "category": "Snip Pick",
        "icon": "$(warning)"
      },
      {
        "command": "snipPick.setServerUrl",
        "title": "Set Server URL\u2026",
        "category": "Snip Pick",
        "icon": "$(gear)"
      },
      {
        "command": "snipPick.selectVaults",
        "title": "Select Vaults\u2026",
        "category": "Snip Pick",
        "icon": "$(cloud)"
      },
      {
        "command": "snipPick.refreshRemote",
        "title": "Refresh Remote Vaults",
        "category": "Snip Pick"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "snipPick.insert",
          "when": "false"
        },
        {
          "command": "snipPick.run",
          "when": "false"
        },
        {
          "command": "snipPick.copy",
          "when": "false"
        },
        {
          "command": "snipPick.edit",
          "when": "false"
        },
        {
          "command": "snipPick.editAsJson",
          "when": "false"
        },
        {
          "command": "snipPick.delete",
          "when": "false"
        },
        {
          "command": "snipPick.togglePin",
          "when": "false"
        },
        {
          "command": "snipPick.duplicate",
          "when": "false"
        },
        {
          "command": "snipPick.moveToGroup",
          "when": "false"
        },
        {
          "command": "snipPick.renameGroup",
          "when": "false"
        },
        {
          "command": "snipPick.deleteGroup",
          "when": "false"
        },
        {
          "command": "snipPick.copyDiscovered",
          "when": "false"
        },
        {
          "command": "snipPick.exportCodeSnippets",
          "when": "false"
        },
        {
          "command": "snipPick.activate",
          "when": "false"
        },
        {
          "command": "snipPick.addSnippetFromSelection",
          "when": "editorHasSelection"
        },
        {
          "command": "snipPick.showAllItems",
          "when": "false"
        }
      ],
      "editor/context": [
        {
          "command": "snipPick.addSnippetFromSelection",
          "when": "editorHasSelection",
          "group": "9_cutcopypaste@100"
        }
      ],
      "view/title": [
        {
          "command": "snipPick.addSnippet",
          "when": "view == snipPick.library",
          "group": "navigation@1"
        },
        {
          "command": "snipPick.addCommand",
          "when": "view == snipPick.library",
          "group": "navigation@2"
        },
        {
          "command": "snipPick.newGroup",
          "when": "view == snipPick.library",
          "group": "navigation@3"
        },
        {
          "command": "snipPick.open",
          "when": "view == snipPick.library",
          "group": "navigation@4"
        },
        {
          "command": "snipPick.toggleRelevantOnly",
          "when": "view == snipPick.library && !snipPick.relevantOnly",
          "group": "navigation@5"
        },
        {
          "command": "snipPick.showAllItems",
          "when": "view == snipPick.library && snipPick.relevantOnly",
          "group": "navigation@5"
        },
        {
          "command": "snipPick.refresh",
          "when": "view == snipPick.library",
          "group": "navigation@6"
        },
        {
          "command": "snipPick.import",
          "when": "view == snipPick.library",
          "group": "1_sync@1"
        },
        {
          "command": "snipPick.export",
          "when": "view == snipPick.library",
          "group": "1_sync@2"
        },
        {
          "command": "snipPick.importCodeSnippets",
          "when": "view == snipPick.library",
          "group": "1_sync@3"
        },
        {
          "command": "snipPick.setSecret",
          "when": "view == snipPick.library",
          "group": "2_secrets@1"
        },
        {
          "command": "snipPick.clearSecrets",
          "when": "view == snipPick.library",
          "group": "2_secrets@2"
        },
        {
          "command": "snipPick.selectVaults",
          "when": "view == snipPick.library",
          "group": "3_remote@1"
        },
        {
          "command": "snipPick.signIn",
          "when": "view == snipPick.library",
          "group": "3_remote@2"
        },
        {
          "command": "snipPick.signOut",
          "when": "view == snipPick.library",
          "group": "3_remote@3"
        },
        {
          "command": "snipPick.setServerUrl",
          "when": "view == snipPick.library",
          "group": "3_remote@4"
        }
      ],
      "view/item/context": [
        {
          "command": "snipPick.insert",
          "when": "view == snipPick.library && viewItem =~ /^snippet/",
          "group": "inline@1"
        },
        {
          "command": "snipPick.run",
          "when": "view == snipPick.library && viewItem == command",
          "group": "inline@1"
        },
        {
          "command": "snipPick.copy",
          "when": "view == snipPick.library && viewItem =~ /^(snippet|command)/",
          "group": "inline@2"
        },
        {
          "command": "snipPick.copyDiscovered",
          "when": "view == snipPick.library && viewItem == discoveredItem",
          "group": "inline@1"
        },
        {
          "command": "snipPick.copy",
          "when": "view == snipPick.library && viewItem == discoveredItem",
          "group": "inline@2"
        },
        {
          "command": "snipPick.edit",
          "when": "view == snipPick.library && viewItem =~ /^(snippet|command)$/",
          "group": "1_modify@1"
        },
        {
          "command": "snipPick.editAsJson",
          "when": "view == snipPick.library && viewItem =~ /^(snippet|command)/",
          "group": "1_modify@2"
        },
        {
          "command": "snipPick.togglePin",
          "when": "view == snipPick.library && viewItem =~ /^(snippet|command)$/",
          "group": "1_modify@3"
        },
        {
          "command": "snipPick.duplicate",
          "when": "view == snipPick.library && viewItem =~ /^(snippet|command)/",
          "group": "1_modify@4"
        },
        {
          "command": "snipPick.moveToGroup",
          "when": "view == snipPick.library && viewItem =~ /^(snippet|command)$/",
          "group": "1_modify@5"
        },
        {
          "command": "snipPick.delete",
          "when": "view == snipPick.library && viewItem =~ /^(snippet|command)$/",
          "group": "2_delete@1"
        },
        {
          "command": "snipPick.addSnippet",
          "when": "view == snipPick.library && viewItem =~ /^(group|scopeRoot)$/",
          "group": "1_add@1"
        },
        {
          "command": "snipPick.addCommand",
          "when": "view == snipPick.library && viewItem =~ /^(group|scopeRoot)$/",
          "group": "1_add@2"
        },
        {
          "command": "snipPick.newGroup",
          "when": "view == snipPick.library && viewItem =~ /^(group|scopeRoot)$/",
          "group": "1_add@3"
        },
        {
          "command": "snipPick.renameGroup",
          "when": "view == snipPick.library && viewItem == group",
          "group": "2_modify@1"
        },
        {
          "command": "snipPick.exportCodeSnippets",
          "when": "view == snipPick.library && viewItem =~ /^group/",
          "group": "2_modify@2"
        },
        {
          "command": "snipPick.deleteGroup",
          "when": "view == snipPick.library && viewItem == group",
          "group": "3_delete@1"
        },
        {
          "command": "snipPick.selectVaults",
          "when": "view == snipPick.library && viewItem == remoteScopeRoot",
          "group": "inline@1"
        },
        {
          "command": "snipPick.setServerUrl",
          "when": "view == snipPick.library && viewItem == signIn",
          "group": "inline@1"
        },
        {
          "command": "snipPick.resolveConflicts",
          "when": "view == snipPick.library && viewItem == vaultConflicts",
          "group": "inline@1"
        }
      ]
    },
    "keybindings": [
      {
        "command": "snipPick.open",
        "key": "ctrl+alt+s",
        "mac": "cmd+alt+s"
      }
    ],
    "configuration": {
      "title": "Snip Pick",
      "properties": {
        "snipPick.allowCrossScopeDrag": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Allow dragging items from one scope to another — User to a workspace folder, or between folders. Off by default: the drop writes the item into a different `snippick.json`, and it is easy to do by accident while reordering. Use **Snip Pick: Export…** / **Import…** to move things deliberately."
        },
        "snipPick.clickAction": {
          "type": "string",
          "enum": [
            "insertOrRun",
            "edit",
            "none"
          ],
          "enumDescriptions": [
            "Insert the snippet or send the command to the terminal.",
            "Open the item in the edit form.",
            "Do nothing."
          ],
          "default": "insertOrRun",
          "description": "What happens when an item in the tree is clicked."
        },
        "snipPick.completions.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Offer snippets that have a prefix as IntelliSense completion items."
        },
        "snipPick.confirmDangerous": {
          "type": "boolean",
          "default": true,
          "description": "Ask for confirmation before sending a potentially destructive command to the terminal."
        },
        "snipPick.defaultScope": {
          "type": "string",
          "enum": [
            "user",
            "workspace"
          ],
          "enumDescriptions": [
            "Store new items in your user library, available in every project on this machine.",
            "Store new items in the project's .vscode/snippick.json, so they can be committed."
          ],
          "default": "user",
          "markdownDescription": "Scope pre-selected when creating new items."
        },
        "snipPick.discovery.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show a read-only \"Discovered\" node with package.json scripts, Makefile targets and justfile recipes."
        },
        "snipPick.remote.url": {
          "type": "string",
          "default": "",
          "markdownDescription": "Base URL of a Snip Pick API, e.g. `https://snippets.your-company.internal`. Leave empty to stay entirely local. Set it in workspace settings to point a project at your company server."
        },
        "snipPick.runBehavior": {
          "type": "string",
          "enum": [
            "paste",
            "execute"
          ],
          "enumDescriptions": [
            "Paste the command into the terminal without pressing Enter.",
            "Paste the command and execute it immediately."
          ],
          "default": "paste",
          "description": "Whether commands are pasted into the terminal or executed right away."
        },
        "snipPick.showRelevantOnly": {
          "type": "boolean",
          "default": false,
          "description": "Only show items that are relevant to the active file."
        }
      }
    },
    "authentication": [
      {
        "id": "snip-pick",
        "label": "Snip Pick"
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "compile": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "compile:tests": "node esbuild.mjs --tests",
    "test:integration": "pnpm run compile && pnpm run compile:tests && vscode-test",
    "package": "vsce package --no-dependencies",
    "icon": "node scripts/render-icon.mjs",
    "vscode:prepublish": "node esbuild.mjs --production"
  },
  "devDependencies": {
    "@snip-pick/api-client": "workspace:*",
    "@snip-pick/contracts": "workspace:*",
    "@snip-pick/core": "workspace:*",
    "@types/mocha": "catalog:",
    "@types/vscode": "^1.95.0",
    "@vscode/test-cli": "catalog:",
    "@vscode/test-electron": "catalog:",
    "@vscode/vsce": "catalog:",
    "esbuild": "catalog:",
    "ovsx": "catalog:"
  }
}
