{
  "name": "snip-pick-monorepo",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/bjeber/snip-pick.git"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=12"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "lint": "oxlint && oxfmt --check .",
    "format": "oxfmt .",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "pnpm --filter snip-pick run test:integration",
    "test": "pnpm run test:unit && pnpm run test:integration",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run test:unit && pnpm run build",
    "package": "pnpm --filter snip-pick run package",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down"
  },
  "devDependencies": {
    "@types/node": "^20.17.6",
    "@vitest/coverage-v8": "^2.1.4",
    "oxfmt": "0.68.0",
    "oxlint": "1.83.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  },
  "packageManager": "pnpm@12.5.1"
}
