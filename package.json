{
  "name": "snip-pick-monorepo",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/bjeber/snip-pick.git"
  },
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=12"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "lint": "oxlint && oxfmt --check .",
    "format": "oxfmt .",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "pnpm --filter snip-pick run test:integration",
    "test": "pnpm run test:unit && pnpm run test:integration",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run test:unit && pnpm run build",
    "package": "pnpm --filter snip-pick run package",
    "db:up": "pnpm --filter @snip-pick/db-tools run up",
    "db:down": "pnpm --filter @snip-pick/db-tools run down",
    "db:reset": "pnpm --filter @snip-pick/db-tools run reset",
    "db:migrate": "pnpm --filter @snip-pick/db-tools run migrate",
    "db:seed": "pnpm --filter @snip-pick/db-tools run seed"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "pnpm@12.5.1"
}
