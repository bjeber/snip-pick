{
  "name": "@snip-pick/db",
  "version": "0.1.0",
  "private": true,
  "description": "Postgres schema, drizzle client factory and migrations. Server-only.",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "drizzle-kit generate",
    "auth:generate": "pnpm dlx @better-auth/cli@1.4.21 generate --config ../auth/src/auth.ts --output src/auth-schema.ts -y"
  },
  "dependencies": {
    "drizzle-orm": "catalog:",
    "pg": "catalog:"
  },
  "devDependencies": {
    "@types/pg": "catalog:",
    "drizzle-kit": "catalog:"
  }
}
