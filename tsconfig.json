{
  // The root test/ directory only — every workspace package has its own. This extends the base
  // rather than restating it, which is how the two came to disagree: the base moved to
  // Preserve/Bundler for TypeScript 7 and this file would have been left on the removed
  // node10 resolution.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"]
  },
  "include": ["test/**/*.ts"]
}
